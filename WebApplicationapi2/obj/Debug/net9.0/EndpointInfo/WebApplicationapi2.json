          },
          "price": {
            "type": "number",
            "format": "currency"
          },
          "qualty": {
            "type": "integer",
            "format": "int32"
          },
          "catogryId": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      }
    }
